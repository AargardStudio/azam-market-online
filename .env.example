# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY: from your Supabase project's
# Project Settings -> API page. The anon key is safe to expose in the browser
# bundle -- every table it touches is locked down by the RLS policies in
# supabase/migrations/20260926230800_row_level_security.sql. Never put the
# service_role key in a VITE_ variable; that one belongs server-side only.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# SUPABASE_SERVICE_ROLE_KEY: from Project Settings -> API. Used ONLY by
# server.ts (never sent to the browser) so the Stripe webhook can update a
# vendor's subscription_status even though RLS blocks that from the client.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Stripe: $5/month vendor subscription, via a Stripe Payment Link ----
# No Stripe secret API key is used anywhere in this app -- checkout is a
# plain redirect to a Payment Link you create once in the Stripe dashboard
# (dashboard.stripe.com):
#  1. Products -> Add a product ("Azam Market Online — Standard"), $5.00
#     USD/month recurring price -> Create payment link. Under the link's
#     "After payment" settings, set a custom redirect to
#     <APP_URL>/?subscribed=1 so the app refreshes the vendor's status.
#     Copy the resulting https://buy.stripe.com/... URL into
#     VITE_STRIPE_PAYMENT_LINK below (safe to expose -- it's a public link,
#     not a secret).
#  2. STRIPE_WEBHOOK_SECRET: Developers -> Webhooks -> add an endpoint
#     pointing at <APP_URL>/api/stripe/webhook, listening for
#     checkout.session.completed, customer.subscription.updated, and
#     customer.subscription.deleted -> copy its signing secret. This is
#     only used to verify that a webhook call really came from Stripe; it
#     is not an API key and grants no account access.
VITE_STRIPE_PAYMENT_LINK="https://buy.stripe.com/your-payment-link"
STRIPE_WEBHOOK_SECRET="whsec_..."
